#!/usr/bin/env python3
import configparser
config = configparser.ConfigParser()
config.read("/etc/pardus/eta-shutdown.conf")

no_auto = ("false" == str(config["AUTO_SHUTDOWN"]["enabled"]).lower())
no_timed = (config["TIMED_MODE"]["mode"] == "none")

import subprocess
subprocess.run(["systemctl", "daemon-reload"])
subprocess.run(["systemctl", "stop", "eta-shutdown"])
if no_auto and no_timed:
    subprocess.run(["systemctl", "disable", "eta-shutdown"])
else:
    subprocess.run(["systemctl", "enable", "eta-shutdown"])
    subprocess.run(["systemctl", "start", "eta-shutdown"])

